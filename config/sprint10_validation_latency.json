{
  "seed": 42,
  "split": {
    "train_fraction": 0.70,
    "calibration_fraction": 0.10,
    "test_fraction": 0.20,
    "order": ["year", "week_of_year", "day_of_week", "hour", "incident_id"],
    "keep_equal_timestamp_in_same_partition": true
  },
  "actual_model": {
    "algorithm": "LogisticRegression",
    "C_grid": [0.1, 1.0, 3.0],
    "class_weight_grid": [null, "balanced"],
    "solver": "liblinear",
    "selection": "minimum calibration weighted_cost within 2%; tie-break lowest Brier",
    "threshold_objective": "minimize FP + 3*FN subject to recall >= 0.85 on calibration",
    "forbidden_features": ["duration_hours", "duration_hours_evidence", "resolution_time", "end_time"]
  },
  "baseline": {
    "name": "BAU_rule_frozen_vS7",
    "threshold": 0.50
  },
  "slo": {
    "p95_ms_warm_single": 150,
    "internal_error_ratio_max": 0.005,
    "minimum_warm_throughput_req_s": 100
  },
  "latency_benchmark": {
    "warmup_iterations": 40,
    "cold_iterations": 80,
    "batch_iterations": {"1": 400, "8": 220, "16": 160, "32": 120, "64": 80}
  },
  "bootstrap_iterations": 1500
}
